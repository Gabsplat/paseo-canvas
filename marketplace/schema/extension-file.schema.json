{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Gabsplat/lienzo-extensions/main/schema/extension-file.schema.json",
  "title": "Lienzo extension file",
  "description": "extensions/<id>/extension.json: what Export in Lienzo writes. scripts/build-index.mjs checks the rest (ids start with the file's id and a dot, docs has no HTML, the folder is named after id, declared actions have their script).",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "id", "name", "description", "blockTypes", "templates", "documents", "extensions"],
  "$defs": {
    "actionSchema": {
      "description": "The JSON Schema subset actions are described with.",
      "type": "object", "additionalProperties": false, "required": ["type"],
      "properties": {
        "type": { "enum": ["object", "array", "string", "number", "integer", "boolean"] },
        "description": { "type": "string", "maxLength": 400 },
        "enum": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "type": ["string", "number", "boolean"] } },
        "minimum": { "type": "number" }, "maximum": { "type": "number" },
        "minLength": { "type": "integer", "minimum": 0 }, "maxLength": { "type": "integer", "minimum": 0 },
        "items": { "$ref": "#/$defs/actionSchema" }, "minItems": { "type": "integer", "minimum": 0 }, "maxItems": { "type": "integer", "minimum": 0 },
        "properties": { "type": "object", "maxProperties": 40, "additionalProperties": { "$ref": "#/$defs/actionSchema" } },
        "required": { "type": "array", "items": { "type": "string" } },
        "additionalProperties": { "type": "boolean" }
      }
    }
  },
  "properties": {
    "format": { "const": "paseo-canvas-pack" },
    "version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$", "maxLength": 100 },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "type": "string", "maxLength": 2000 },
    "blockTypes": { "type": "array", "maxItems": 0 },
    "templates": { "type": "array", "maxItems": 0 },
    "documents": { "type": "array", "maxItems": 0 },
    "extensions": {
      "type": "array", "minItems": 1, "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "api", "name", "description", "html"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$", "maxLength": 100 },
          "kind": { "const": "tool" },
          "api": { "const": 1 },
          "name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "description": { "type": "string", "minLength": 1, "maxLength": 600 },
          "icon": { "type": "string", "pattern": "^[A-Za-z0-9]{1,40}$", "description": "A Lucide icon name, like CaseSensitive." },
          "html": { "type": "string", "minLength": 1, "maxLength": 300000 },
          "permissions": { "type": "array", "uniqueItems": true, "maxItems": 2, "items": { "enum": ["edit", "network"] } },
          "actions": {
            "description": "What the extension offers an agent (canvas_extension_run). Each handler is registered with lienzo.action(name, fn) in a <script data-lienzo=\"actions\"> of html.",
            "type": "array", "minItems": 1, "maxItems": 20,
            "items": {
              "type": "object", "additionalProperties": false, "required": ["name", "description"],
              "properties": {
                "name": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,39}$" },
                "description": { "type": "string", "minLength": 1, "maxLength": 600 },
                "input": { "$ref": "#/$defs/actionSchema", "description": "An object schema: the action's named arguments. Objects are closed unless additionalProperties is true." },
                "returns": { "$ref": "#/$defs/actionSchema", "description": "What it returns, for documentation." }
              }
            }
          },
          "docs": {
            "description": "The extension's Help page: Markdown without HTML, or titled sections.",
            "oneOf": [
              { "type": "string", "minLength": 1, "maxLength": 20000 },
              { "type": "array", "minItems": 1, "maxItems": 12, "items": { "type": "object", "additionalProperties": false, "required": ["title", "body"], "properties": { "title": { "type": "string", "minLength": 1, "maxLength": 120 }, "body": { "type": "string", "maxLength": 20000 } } } }
            ]
          }
        }
      }
    }
  }
}
