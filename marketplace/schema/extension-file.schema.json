{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Gabsplat/lienzo-extensions/main/schema/extension-file.schema.json",
  "title": "Lienzo extension file",
  "description": "extensions/<id>/extension.json: what Export in Lienzo writes. scripts/build-index.mjs checks the rest (ids start with the file's id and a dot, docs has no HTML, the folder is named after id).",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "id", "name", "description", "blockTypes", "templates", "documents", "extensions"],
  "properties": {
    "format": { "const": "paseo-canvas-pack" },
    "version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$", "maxLength": 100 },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "type": "string", "maxLength": 2000 },
    "blockTypes": { "type": "array", "maxItems": 0 },
    "templates": { "type": "array", "maxItems": 0 },
    "documents": { "type": "array", "maxItems": 0 },
    "extensions": {
      "type": "array", "minItems": 1, "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "api", "name", "description", "html"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$", "maxLength": 100 },
          "kind": { "const": "tool" },
          "api": { "const": 1 },
          "name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "description": { "type": "string", "minLength": 1, "maxLength": 600 },
          "icon": { "type": "string", "pattern": "^[A-Za-z0-9]{1,40}$", "description": "A Lucide icon name, like CaseSensitive." },
          "html": { "type": "string", "minLength": 1, "maxLength": 300000 },
          "permissions": { "type": "array", "uniqueItems": true, "maxItems": 2, "items": { "enum": ["edit", "network"] } },
          "docs": {
            "description": "The extension's Help page: Markdown without HTML, or titled sections.",
            "oneOf": [
              { "type": "string", "minLength": 1, "maxLength": 20000 },
              { "type": "array", "minItems": 1, "maxItems": 12, "items": { "type": "object", "additionalProperties": false, "required": ["title", "body"], "properties": { "title": { "type": "string", "minLength": 1, "maxLength": 120 }, "body": { "type": "string", "maxLength": 20000 } } } }
            ]
          }
        }
      }
    }
  }
}
