{
  "title": "Lienzo extension index",
  "description": "index.json, built by scripts/build-index.mjs. Generated from plugin/shared/marketplace.ts in github.com/Gabsplat/paseo-canvas.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "lienzo-extension-index"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "repository": {
      "type": "string",
      "maxLength": 200
    },
    "generatedAt": {
      "type": "string",
      "maxLength": 40
    },
    "entries": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "extensions": {
            "minItems": 1,
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100,
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "description": {
                  "type": "string",
                  "maxLength": 600
                },
                "icon": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9]{1,40}$"
                },
                "permissions": {
                  "maxItems": 2,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "edit",
                      "network"
                    ]
                  }
                },
                "docs": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "name",
                "description",
                "permissions",
                "docs"
              ],
              "additionalProperties": false
            }
          },
          "path": {
            "type": "string",
            "maxLength": 300,
            "pattern": "^extensions\\/[a-zA-Z0-9][a-zA-Z0-9._-]*\\/[A-Za-z0-9._-]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 1048576
          },
          "author": {
            "type": "string",
            "maxLength": 100
          },
          "updated": {
            "type": "string",
            "maxLength": 40
          },
          "readme": {
            "type": "string",
            "maxLength": 300,
            "pattern": "^extensions\\/[a-zA-Z0-9][a-zA-Z0-9._-]*\\/[A-Za-z0-9._-]+$"
          },
          "screenshot": {
            "type": "string",
            "maxLength": 300,
            "pattern": "^extensions\\/[a-zA-Z0-9][a-zA-Z0-9._-]*\\/[A-Za-z0-9._-]+$"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "extensions",
          "path",
          "sha256",
          "bytes"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "format",
    "version",
    "repository",
    "generatedAt",
    "entries"
  ],
  "additionalProperties": false
}
